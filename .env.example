# Port the web app listens on (server sets this from app_port)
PORT=8000
# Where SQLite and other persistent data live
DATA_DIR=/data
# Any OpenAI-compatible server (Ollama, llama.cpp llama-server) for the parse fallback
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
# Seconds per LLM request (default 120); ~300 on a CPU-only server
# LLM_TIMEOUT=300
# whisper.cpp for the audio fallback (brew install whisper-cpp); the Docker image sets these
WHISPER_BIN=whisper-cli
WHISPER_MODEL=models/ggml-base.en.bin
# Threads for whisper (default: all CPUs)
# WHISPER_THREADS=4
